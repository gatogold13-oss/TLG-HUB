local function StartFly()
    if V3 then return end
    if MapOrbitOn then MapOrbitOn = false; if MapOrbitConn then MapOrbitConn:Disconnect() MapOrbitConn = nil end; if OrbitSt then OrbitSt.SetState(false) end end
    V3 = true
