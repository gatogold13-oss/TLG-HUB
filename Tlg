local function RefreshPlayers()
    for _, c in pairs(PList:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    PlayerButtons = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local b = Instance.new("TextButton", PList)
            b.Size = UDim2.new(0.98, 0, 0, 18)
            b.BackgroundColor3 = ElementBg
            b.Text = "👤 " .. p.DisplayName
            b.TextColor3 = Color3.fromRGB(200, 210, 220)
            b.TextSize = 7.5
            b.Font = Enum.Font.Gotham
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 3)
            b.MouseButton1Click:Connect(function()
                if not p or not p.Parent then return end
                Config.SelectedPlayer = p.Name
                TargetLabel.Text = "Target: " .. p.DisplayName
                Notify("Target", p.DisplayName, 2)
            end)
            PlayerButtons[p] = b
        end
    end
end
Players.PlayerAdded:Connect(function(p)
    task.wait(0.5)
    RefreshPlayers()
end)
Players.PlayerRemoving:Connect(function(p)
    -- Limpieza completa de referencias
    if Config.SelectedPlayer == p.Name then
        Config.SelectedPlayer = nil
        TargetLabel.Text = "Target: Auto"
    end
    PlayerButtons[p] = nil
    OriginalHRPProps[p] = nil
    OriginalAllProps[p] = nil
    RefreshPlayers()
end)
RefreshPlayers()

