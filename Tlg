local function CreateToggle(text, parent, callback, initial)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.98, 0, 0, 22)
    btn.BackgroundColor3 = ElementBg
    btn.Text = ((initial and "🟢 ") or "🔴 ") .. text
    btn.TextColor3 = initial and OrangeGlow or Color3.fromRGB(200, 210, 220)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 8
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = initial and OrangeGlow or Color3.fromRGB(50, 60, 75)
    local enabled = initial or false
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        btn.Text = (enabled and "🟢 " or "🔴 ") .. text
        btn.TextColor3 = enabled and OrangeGlow or Color3.fromRGB(200, 210, 220)
        stroke.Color = enabled and OrangeGlow or Color3.fromRGB(50, 60, 75)
        callback(enabled)
    end)
    if initial then callback(true) end
    return btn
end

