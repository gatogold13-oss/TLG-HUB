local function SaveOriginalProps(p)
    if not p.Character then return end
    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
    local head = p.Character:FindFirstChild("Head")
    if hrp and head and not OriginalAllProps[p] then
        OriginalAllProps[p] = {
            HRP_Size = hrp.Size, HRP_Shape = hrp.Shape, HRP_Transparency = hrp.Transparency, HRP_CanCollide = hrp.CanCollide, HRP_Color = hrp.Color,
            Head_Size = head.Size, Head_Shape = head.Shape, Head_Transparency = head.Transparency, Head_CanCollide = head.CanCollide, Head_Massless = head.Massless, Head_Color = head.Color,
        }
    end
end

local function RestoreProps(p)
    if not p or not p.Character then
        OriginalAllProps[p] = nil
        return
    end
    local o = OriginalAllProps[p]
    if not o then return end
    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
    local head = p.Character:FindFirstChild("Head")
    pcall(function()
        if hrp then
            hrp.Size = o.HRP_Size
            hrp.Shape = o.HRP_Shape
            hrp.Transparency = o.HRP_Transparency
            hrp.CanCollide = o.HRP_CanCollide
            hrp.Color = o.HRP_Color
        end
        if head then
            head.Size = o.Head_Size
            head.Shape = o.Head_Shape
            head.Transparency = o.Head_Transparency
            head.CanCollide = o.Head_CanCollide
            head.Massless = o.Head_Massless
            head.Color = o.Head_Color
        end
    end)
    OriginalAllProps[p] = nil
end

local function ApplySphereHitbox(p)
    if p == LocalPlayer then return end
    if not p or not p.Parent then return end
    if not p.Character then return end
    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
    local head = p.Character:FindFirstChild("Head")
    if not hrp or not head then return end

    SaveOriginalProps(p)
    local o = OriginalAllProps[p]

    pcall(function()
        if Config.KatanaFixEnabled or Config.HeadModeEnabled then
            head.Shape = Enum.PartType.Ball
            head.Size = Vector3.new(Config.SphereSize, Config.SphereSize, Config.SphereSize)
            head.Color = Config.SphereColor
            head.Transparency = Config.SphereTransparency
            head.CanCollide = false
            head.Massless = true
            if o then
                hrp.Size = o.HRP_Size
                hrp.Shape = o.HRP_Shape
                hrp.Transparency = o.HRP_Transparency
                hrp.CanCollide = o.HRP_CanCollide
            end
        else
            hrp.Shape = Enum.PartType.Ball
            hrp.Size = Vector3.new(Config.SphereSize, Config.SphereSize, Config.SphereSize)
            hrp.Color = Config.SphereColor
            hrp.Transparency = Config.SphereTransparency
            hrp.CanCollide = false
            if o then
                head.Size = o.Head_Size
                head.Shape = o.Head_Shape
                head.Transparency = o.Head_Transparency
                head.CanCollide = o.Head_CanCollide
                head.Massless = o.Head_Massless
            end
        end
    end)
end

local function ClearAllHitboxes()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            RestoreProps(p)
        end
    end
end

