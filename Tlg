RunService.Stepped:Connect(function()
    if not ScriptActive then return end

    -- Esfera hitbox
    if Config.SphereHBEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                ApplySphereHitbox(p)
            end
        end
    elseif next(OriginalAllProps) ~= nil then
        ClearAllHitboxes()
    end

    -- Hitbox 100k
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = p.Character.HumanoidRootPart
            if Config.HitboxEnabled and not Config.SphereHBEnabled then
                if not OriginalHRPProps[p] then
                    OriginalHRPProps[p] = {Size = hrp.Size, Shape = hrp.Shape}
                end
                hrp.Shape = Enum.PartType.Block
                hrp.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                hrp.Transparency = 1
                hrp.CanCollide = false
            elseif OriginalHRPProps[p] and not Config.SphereHBEnabled then
                hrp.Size = OriginalHRPProps[p].Size
                hrp.Shape = OriginalHRPProps[p].Shape
                hrp.Transparency = 0
                hrp.CanCollide = true
                OriginalHRPProps[p] = nil
            end
        end
    end

    -- ✅ BANG (llamada al método arreglado)
    if Config.GodOrbBangEnabled then
        PerformBang()
    end

    -- Multi-jump
    if Config.MultiJumpEnabled then
        local h = GetHum()
        if h and h.FloorMaterial ~= Enum.Material.Air then JumpsUsed = 0 end
    end

    -- ESP
    if Config.ESPDistanceEnabled and GetHRP() then
        local myHrp = GetHRP()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                pcall(function()
                    local head = p.Character.Head
                    local hrp2 = p.Character:FindFirstChild("HumanoidRootPart")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hrp2 then
                        local dist = math.floor((myHrp.Position - hrp2.Position).Magnitude)
                        if not head:FindFirstChild("TLG_ESP") then
                            local bg = Instance.new("BillboardGui", head)
                            bg.Name = "TLG_ESP"
                            bg.Size = UDim2.new(0, 200, 0, 40)
                            bg.StudsOffset = Vector3.new(0, 3, 0)
                            bg.AlwaysOnTop = true
                            local lbl = Instance.new("TextLabel", bg)
                            lbl.Name = "L"
                            lbl.Size = UDim2.new(1, 0, 1, 0)
                            lbl.BackgroundTransparency = 1
                            lbl.TextColor3 = OrangeGlow
                            lbl.TextSize = 12
                            lbl.Font = Enum.Font.GothamBold
                            lbl.TextStrokeTransparency = 0
                        end
                        local hp = hum and math.floor(hum.Health) or 0
                        head.TLG_ESP.L.Text = p.DisplayName .. "\n[" .. dist .. "m] " .. hp .. "HP"
                    end
                end)
            elseif p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("TLG_ESP") then
                p.Character.Head.TLG_ESP:Destroy()
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("TLG_ESP") then
                p.Character.Head.TLG_ESP:Destroy()
            end
        end
    end

    -- Speed
    local hum = GetHum()
    if hum and Config.SpeedEnabled then hum.WalkSpeed = Config.SpeedValue end

    -- Fly
    if Config.FlyEnabled and GetHRP() then
        pcall(function()
            local hrp = GetHRP()
            if not BodyVelocity or not BodyVelocity.Parent then
                BodyVelocity = Instance.new("BodyVelocity", hrp)
                BodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            end
            if not BodyGyro or not BodyGyro.Parent then
                BodyGyro = Instance.new("BodyGyro", hrp)
                BodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            end
            local md = hum.MoveDirection
            BodyVelocity.Velocity = (md.Magnitude > 0) and (Camera.CFrame.LookVector * Config.FlySpeed) or Vector3.zero
            BodyGyro.CFrame = Camera.CFrame
        end)
    end

    -- Anti-Stun
    if Config.AntiStunEnabled and tick() - LastAntiStunFix > 0.1 then
        LastAntiStunFix = tick()
        local c, h, hrp = GetChar(), GetHum(), GetHRP()
        if c and h and hrp then
            pcall(function()
                RestoreStates(h)
                if h.WalkSpeed < 16 then h.WalkSpeed = 16 end
                if h.UseJumpPower and h.JumpPower < 50 then h.JumpPower = 50 end
                if h.PlatformStand then h.PlatformStand = false end
                if h.Sit then h.Sit = false end
                if hrp.Anchored then hrp.Anchored = false end
            end)
        end
    end

    -- Fast Attack
    if Config.FastAttackEnabled then
        pcall(function()
            local t = GetChar() and GetChar():FindFirstChildOfClass("Tool")
            if t then t:Activate() end
        end)
    end

    -- Auto Fuga
    if Config.SafeAnchorEnabled then
        local h = GetHum()
        if h and h.Health <= h.MaxHealth * 0.15 and tick() - LastFuga > 3 then
            PerformFuga(10000)
        end
    end
end)

