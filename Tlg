-- ============================================================
-- ✅ GOD ORB BANG - VERSIÓN ARREGLADA (sin lag)
-- ============================================================
local function PerformBang()
    if not Config.GodOrbBangEnabled then return end
    if tick() - LastBang < Config.BangCooldown then return end

    -- Verificar que hay target
    local target = nil
    if Config.SelectedPlayer then
        target = Players:FindFirstChild(Config.SelectedPlayer)
    else
        -- Auto: buscar el más cercano
        local myHrp = GetHRP()
        if myHrp then
            local closest, minDist = nil, Config.BangDistance
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        local d = SafeDist(myHrp.Position, hrp.Position)
                        if d < minDist then
                            closest, minDist = p, d
                        end
                    end
                end
            end
            target = closest
        end
    end

    if not target or not target.Character then return end
    local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not tHRP then return end

    local myHRP = GetHRP()
    local hum = GetHum()
    if not myHRP or not hum then return end

    -- Verificar distancia (solo bangear si está dentro del rango)
    local distance = SafeDist(myHRP.Position, tHRP.Position)
    if distance > Config.BangDistance then return end

    LastBang = tick()

    pcall(function()
        -- 1) Resetear velocidades ANTES del teleport (evita rubber-band)
        myHRP.AssemblyLinearVelocity = Vector3.zero
        myHRP.AssemblyAngularVelocity = Vector3.zero

        -- 2) Calcular posición: detrás del enemigo mirándolo
        local targetCF = tHRP.CFrame
        local behindCF = targetCF * CFrame.new(0, 0, Config.BangOffset)

        -- 3) Teleport (suave o instantáneo)
        if Config.BangSmoothMode then
            -- Lerp para movimiento suave
            myHRP.CFrame = myHRP.CFrame:Lerp(behindCF, 0.6)
        else
            myHRP.CFrame = behindCF
        end

        -- 4) Resetear velocidades DESPUÉS (evita inercia residual)
        myHRP.AssemblyLinearVelocity = Vector3.zero
        myHRP.AssemblyAngularVelocity = Vector3.zero

        -- 5) Auto-cámara: sigue al enemigo suavemente
        if Config.BangAutoCamera and Camera then
            local desiredCF = CFrame.new(behindCF.Position + Vector3.new(0, 4, 8), tHRP.Position)
            Camera.CFrame = Camera.CFrame:Lerp(desiredCF, 0.15)
        end

        -- 6) Forzar al Humanoid a estado Running para no quedar bloqueado
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end)
end

