function PerformFuga(h)
    if tick() - LastFuga < 0.5 then return end
    LastFuga = tick()
    local hrp, hum = GetHRP(), GetHum()
    if not hrp or not hum then return end
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if hrp.Anchored then hrp.Anchored = false end
        local cf = hrp.CFrame
        hrp.CFrame = CFrame.new(cf.Position + Vector3.new(0, h or 10000, 0)) * (cf - cf.Position)
        task.wait()
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hum:ChangeState(Enum.HumanoidStateType.Freefall)
        end
        if Camera then
            Camera.CFrame = hrp.CFrame * CFrame.new(0, 2, 8)
        end
    end)
end

function PerformDash()
    if not Config.DashEnabled then return end
    if tick() - LastDash < Config.DashCooldown then return end
    LastDash = tick()
    local hrp, hum = GetHRP(), GetHum()
    if not hrp or not hum then return end
    pcall(function()
        local dir = Camera.CFrame.LookVector
        local flat = Vector3.new(dir.X, 0, dir.Z)
        if flat.Magnitude < 0.1 then flat = Vector3.new(0, 0, -1) end
        flat = flat.Unit
        hrp.AssemblyLinearVelocity = Vector3.new(flat.X * Config.DashPower, Config.DashUpPower, flat.Z * Config.DashPower)
    end)
end

local function RestoreStates(hum)
    pcall(function()
        for _, st in ipairs({Enum.HumanoidStateType.Jumping, Enum.HumanoidStateType.Freefall, Enum.HumanoidStateType.Landed, Enum.HumanoidStateType.Running, Enum.HumanoidStateType.RunningNoPhysics}) do
            hum:SetStateEnabled(st, true)
        end
        for _, st in ipairs({Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Physics, Enum.HumanoidStateType.PlatformStanding}) do
            hum:SetStateEnabled(st, false)
        end
    end)
end

function EnableAntiLagPRO()
    pcall(function()
        AntiLagCache.OriginalLighting = {
            GlobalShadows=Lighting.GlobalShadows, FogEnd=Lighting.FogEnd,
            FogStart=Lighting.FogStart, Brightness=Lighting.Brightness,
        }
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1e6; Lighting.FogStart = 1e6
        Lighting.Brightness = 1
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("PostEffect") or e:IsA("Atmosphere") then e.Enabled = false end
        end
    end)
end
function DisableAntiLagPRO()
    pcall(function()
        if AntiLagCache.OriginalLighting then
            for k, v in pairs(AntiLagCache.OriginalLighting) do Lighting[k] = v end
        end
    end)
end

